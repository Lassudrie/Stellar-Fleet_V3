{
  "name": "stellar-fleet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "check:runtime": "node ./tools/runtimeCheck.mjs",
    "smoke": "npm run check:runtime && node --import ./tools/registerTsLoader.mjs src/engine/aiSmoke.ts",
    "battle:sim": "npm run check:runtime && tsx tools/battleSim.ts",
    "worldgen:audit": "npm run check:runtime && node --import ./tools/registerTsLoader.mjs ./tools/worldgenAudit.mjs",
    "test": "npm run check:runtime && tsx src/engine/tests/engine.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2"
  }
}
